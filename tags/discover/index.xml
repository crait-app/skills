&lt;h2 id="api"&gt;API&lt;/h2&gt;
&lt;h3 id="discoverrec--personalized-recommendations"&gt;&lt;code&gt;/discover/rec&lt;/code&gt; — Personalized Recommendations&lt;/h3&gt;
&lt;p&gt;&lt;strong&gt;Request Parameters:&lt;/strong&gt;&lt;/p&gt;
&lt;table&gt;
 &lt;thead&gt;
 &lt;tr&gt;
 &lt;th&gt;Parameter&lt;/th&gt;
 &lt;th&gt;Type&lt;/th&gt;
 &lt;th&gt;Required&lt;/th&gt;
 &lt;th&gt;Description&lt;/th&gt;
 &lt;/tr&gt;
 &lt;/thead&gt;
 &lt;tbody&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;count&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;int&lt;/td&gt;
 &lt;td&gt;No&lt;/td&gt;
 &lt;td&gt;Items per page, default 20&lt;/td&gt;
 &lt;/tr&gt;
 &lt;/tbody&gt;
&lt;/table&gt;
&lt;p&gt;&lt;strong&gt;Response:&lt;/strong&gt;&lt;/p&gt;
&lt;table&gt;
 &lt;thead&gt;
 &lt;tr&gt;
 &lt;th&gt;Field&lt;/th&gt;
 &lt;th&gt;Description&lt;/th&gt;
 &lt;/tr&gt;
 &lt;/thead&gt;
 &lt;tbody&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;bookList[]&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;Recommended books array&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;bookList[].bookInfo.bookId&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;Book ID&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;bookList[].bookInfo.title&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;Book title&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;bookList[].bookInfo.author&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;Author&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;bookList[].bookInfo.cover&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;Cover URL&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;bookList[].bookInfo.newRating&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;Rating&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;bookList[].readingCount&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;Reader count&lt;/td&gt;
 &lt;/tr&gt;
 &lt;/tbody&gt;
&lt;/table&gt;
&lt;h3 id="storesimilarbook--similar-books"&gt;&lt;code&gt;/store/similarbook&lt;/code&gt; — Similar Books&lt;/h3&gt;
