 &lt;td&gt;Yes&lt;/td&gt;
 &lt;td&gt;Book ID&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;count&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;int&lt;/td&gt;
