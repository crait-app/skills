 &lt;/tr&gt;
 &lt;/thead&gt;
 &lt;tbody&gt;
 &lt;tr&gt;
 &lt;td&gt;Search Books&lt;/td&gt;
 &lt;td&gt;Search in bookstore&lt;/td&gt;
 &lt;td&gt;&amp;ldquo;Search for Three-Body&amp;rdquo;&lt;/td&gt;
 &lt;td&gt;&lt;code&gt;search.md&lt;/code&gt;&lt;/td&gt;
 &lt;/tr&gt;
