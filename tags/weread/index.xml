 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Notes &amp;amp; Highlights&lt;/td&gt;
 &lt;td&gt;View personal notes, underlines, bookmarks&lt;/td&gt;
 &lt;td&gt;&amp;ldquo;Show my notes in Three-Body&amp;rdquo;&lt;/td&gt;
 &lt;td&gt;&lt;code&gt;notes.md&lt;/code&gt;&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Popular Highlights&lt;/td&gt;
 &lt;td&gt;View popular chapter highlights&lt;/td&gt;
 &lt;td&gt;&amp;ldquo;Show popular highlights in this chapter&amp;rdquo;&lt;/td&gt;
 &lt;td&gt;&lt;code&gt;notes.md&lt;/code&gt;&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Book Reviews&lt;/td&gt;
 &lt;td&gt;View public reviews&lt;/td&gt;
 &lt;td&gt;&amp;ldquo;What reviews are there for Three-Body?&amp;rdquo;&lt;/td&gt;
 &lt;td&gt;&lt;code&gt;review.md&lt;/code&gt;&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Discover&lt;/td&gt;
 &lt;td&gt;Personalized recommendations&lt;/td&gt;
 &lt;td&gt;&amp;ldquo;Recommend some books&amp;rdquo;&lt;/td&gt;
