<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>WeRead on Agent Skills Hub</title><link>https://agentskill.wiki/tags/weread/</link><description>Recent content in WeRead on Agent Skills Hub</description><generator>Hugo</generator><language>en-US</language><lastBuildDate>Sun, 17 May 2026 00:00:00 +0000</lastBuildDate><atom:link href="https://agentskill.wiki/tags/weread/index.xml" rel="self" type="application/rss+xml"/><item><title>WeRead</title><link>https://agentskill.wiki/skills/weread/</link><pubDate>Sun, 17 May 2026 00:00:00 +0000</pubDate><guid>https://agentskill.wiki/skills/weread/</guid><description>&lt;h1 id="weread---weread-assistant"&gt;WeRead - WeRead Assistant&lt;/h1&gt;
&lt;p&gt;Call WeRead API through Agent API Gateway, providing search, bookshelf, notes, reviews and other capabilities.&lt;/p&gt;
&lt;h2 id="supported-capabilities"&gt;Supported Capabilities&lt;/h2&gt;
