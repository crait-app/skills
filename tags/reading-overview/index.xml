<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Reading Overview on Agent Skills Hub</title><link>https://agentskill.wiki/tags/reading-overview/</link><description>Recent content in Reading Overview on Agent Skills Hub</description><generator>Hugo</generator><language>en-US</language><lastBuildDate>Sun, 17 May 2026 00:00:00 +0000</lastBuildDate><atom:link href="https://agentskill.wiki/tags/reading-overview/index.xml" rel="self" type="application/rss+xml"/><item><title>WeRead Profile</title><link>https://agentskill.wiki/skills/weread-profile/</link><pubDate>Sun, 17 May 2026 00:00:00 +0000</pubDate><guid>https://agentskill.wiki/skills/weread-profile/</guid><description>&lt;h1 id="profile--user-profile"&gt;profile — User Profile&lt;/h1&gt;
&lt;h2 id="api"&gt;API&lt;/h2&gt;
&lt;h3 id="userget--user-basic-info"&gt;&lt;code&gt;/user/get&lt;/code&gt; — User Basic Info&lt;/h3&gt;
&lt;p&gt;&lt;strong&gt;Request Parameters:&lt;/strong&gt; None&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Response:&lt;/strong&gt;&lt;/p&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;Field&lt;/th&gt;
					&lt;th&gt;Description&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;userName&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;User nickname&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;avatar&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Avatar URL&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;level&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;WeRead level&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;exp&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Current experience&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;nextExp&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Experience needed for next level&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;
&lt;h3 id="userstats--reading-statistics"&gt;&lt;code&gt;/user/stats&lt;/code&gt; — Reading Statistics&lt;/h3&gt;
&lt;p&gt;&lt;strong&gt;Request Parameters:&lt;/strong&gt; None&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Response:&lt;/strong&gt;&lt;/p&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;Field&lt;/th&gt;
					&lt;th&gt;Description&lt;/th&gt;
					&lt;th&gt;Unit&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;totalReadBooks&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Total finished books&lt;/td&gt;
					&lt;td&gt;books&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;totalReadingTime&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Total reading duration&lt;/td&gt;
					&lt;td&gt;seconds&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;totalNotes&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Total notes&lt;/td&gt;
					&lt;td&gt;notes&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;totalHighlights&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Total highlights&lt;/td&gt;
					&lt;td&gt;highlights&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;totalReviews&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Total reviews written&lt;/td&gt;
					&lt;td&gt;reviews&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;readingDays&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Total reading days&lt;/td&gt;
					&lt;td&gt;days&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;
&lt;h2 id="output-format"&gt;Output Format&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Convert seconds to &amp;ldquo;X hours Y minutes&amp;rdquo;&lt;/li&gt;
&lt;li&gt;Display level progress as percentage&lt;/li&gt;
&lt;li&gt;Use natural language summary&lt;/li&gt;
&lt;/ul&gt;</description></item></channel></rss>